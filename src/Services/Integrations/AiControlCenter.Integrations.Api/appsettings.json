{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:8080", "Protocols": "Http1" },
      "Grpc": { "Url": "http://0.0.0.0:8081", "Protocols": "Http2" }
    }
  },
  "Authentication": {
    "Issuer": "AiControlCenter.Identity",
    "Audience": "aicontrolcenter-api",
    "PublicKeyPath": "/run/aicontrolcenter-keys/identity-public.pem",
    "KeyId": "identity-dev-2026-01",
    "ClockSkewSeconds": 30
  },
  "DataProtection": {
    "KeysPath": "/var/lib/aicontrolcenter/integrations-dpkeys"
  },
  "Providers": {
    "GitHub": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": "",
      "CallbackUrl": "http://localhost:8080/api/integrations/v1/provider-connections/github/oauth/callback"
    },
    "LocalCopilotCli": {
      "Enabled": false,
      "Endpoint": "local-copilot-cli:4321",
      "ManagementEndpoint": "http://local-copilot-cli:4322",
      "ConnectionToken": "",
      "OwnerUserId": "00000000-0000-0000-0000-000000000000",
      "RequestTimeoutSeconds": 120
    },
    "OpenAi": { "BaseUrl": "https://api.openai.com/" },
    "XAi": { "BaseUrl": "https://api.x.ai/" }
  },
  "ProviderConnectionFeatures": {
    "GitHubCopilotOAuthEnabled": false,
    "GitHubCopilotPatEnabled": false,
    "LocalCopilotCliEnabled": false
  },
  "AllowedHosts": "*"
}
