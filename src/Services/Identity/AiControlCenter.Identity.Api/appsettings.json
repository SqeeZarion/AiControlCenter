{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Authentication": {
    "Issuer": "AiControlCenter.Identity",
    "Audience": "aicontrolcenter-api",
    "PublicKeyPath": "/run/aicontrolcenter-keys/identity-public.pem",
    "KeyId": "identity-dev-2026-01",
    "Algorithm": "RS256",
    "ClockSkewSeconds": 30
  },
  "JwtSigning": {
    "PrivateKeyPath": "/run/aicontrolcenter-keys/identity-private.pem",
    "AccessTokenMinutes": 10
  },
  "DataProtection": {
    "KeysPath": "/var/lib/aicontrolcenter/data-protection"
  },
  "Security": {
    "AllowedOrigins": ["http://localhost:8080"]
  },
  "ForwardedHeaders": {
    "KnownProxies": ["172.31.0.20"]
  },
  "AllowedHosts": "*"
}
