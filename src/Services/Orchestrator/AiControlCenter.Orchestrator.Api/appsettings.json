{
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:8080", "Protocols": "Http1" },
      "Grpc": { "Url": "http://0.0.0.0:8081", "Protocols": "Http2" }
    }
  },
  "ControlPlane": {
    "GrpcAddress": "http://controlplane-api:8081"
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": 5672
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "MassTransit": "Information"
    }
  },
  "Authentication": {
    "Issuer": "AiControlCenter.Identity",
    "Audience": "aicontrolcenter-api",
    "PublicKeyPath": "/run/aicontrolcenter-keys/identity-public.pem",
    "KeyId": "identity-dev-2026-01",
    "ClockSkewSeconds": 30
  },
  "AllowedHosts": "*"
}
