{
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/identity" }]
      },
      "control-plane": {
        "ClusterId": "control-plane",
        "Match": { "Path": "/api/control-plane/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/control-plane" }]
      },
      "orchestrator": {
        "ClusterId": "orchestrator",
        "Match": { "Path": "/api/orchestrator/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/orchestrator" }]
      },
      "integrations": {
        "ClusterId": "integrations",
        "Match": { "Path": "/api/integrations/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/integrations" }]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "primary": { "Address": "http://identity-api:8080/" } }
      },
      "control-plane": {
        "Destinations": { "primary": { "Address": "http://controlplane-api:8080/" } }
      },
      "orchestrator": {
        "Destinations": { "primary": { "Address": "http://orchestrator-api:8080/" } }
      },
      "integrations": {
        "Destinations": { "primary": { "Address": "http://integrations-api:8080/" } }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*"
}
