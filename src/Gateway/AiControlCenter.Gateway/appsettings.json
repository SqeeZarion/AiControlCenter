{
  "RabbitMq": {
    "Enabled": false,
    "Host": "rabbitmq",
    "Port": 5672
  },
  "OperationsCenter": {
    "RequestTimeoutSeconds": 3,
    "FreshnessSeconds": 30,
    "RabbitMqManagementAddress": "http://rabbitmq:15672",
    "Services": {
      "identity": {
        "Label": "Identity",
        "Address": "http://identity-api:8080"
      },
      "control-plane": {
        "Label": "ControlPlane",
        "Address": "http://controlplane-api:8080"
      },
      "orchestrator": {
        "Label": "Orchestrator",
        "Address": "http://orchestrator-api:8080"
      },
      "worker": {
        "Label": "Worker",
        "Address": "http://worker-service:8080"
      },
      "integrations": {
        "Label": "Integrations",
        "Address": "http://integrations-api:8080"
      }
    },
    "Queues": [
      "aicontrolcenter-worker-agent-runs-v1",
      "aicontrolcenter-orchestrator-run-faults-v1",
      "aicontrolcenter-gateway-run-status-v1"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-csrf": {
        "ClusterId": "identity",
        "Order": -10,
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api/identity/v1/auth/csrf" },
        "Transforms": [{ "PathRemovePrefix": "/api/identity" }]
      },
      "identity-login": {
        "ClusterId": "identity",
        "Order": -10,
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api/identity/v1/auth/login" },
        "Transforms": [{ "PathRemovePrefix": "/api/identity" }]
      },
      "identity-refresh": {
        "ClusterId": "identity",
        "Order": -10,
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api/identity/v1/auth/refresh" },
        "Transforms": [{ "PathRemovePrefix": "/api/identity" }]
      },
      "identity-logout": {
        "ClusterId": "identity",
        "Order": -10,
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api/identity/v1/auth/logout" },
        "Transforms": [{ "PathRemovePrefix": "/api/identity" }]
      },
      "identity": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/identity" }]
      },
      "control-plane": {
        "ClusterId": "control-plane",
        "AuthorizationPolicy": "PasswordChanged",
        "Match": { "Path": "/api/control-plane/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/control-plane" }]
      },
      "orchestrator": {
        "ClusterId": "orchestrator",
        "AuthorizationPolicy": "PasswordChanged",
        "Match": { "Path": "/api/orchestrator/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/orchestrator" }]
      },
      "integrations": {
        "ClusterId": "integrations",
        "AuthorizationPolicy": "PasswordChanged",
        "Match": { "Path": "/api/integrations/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/integrations" }]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "primary": { "Address": "http://identity-api:8080/" } }
      },
      "control-plane": {
        "Destinations": { "primary": { "Address": "http://controlplane-api:8080/" } }
      },
      "orchestrator": {
        "Destinations": { "primary": { "Address": "http://orchestrator-api:8080/" } }
      },
      "integrations": {
        "Destinations": { "primary": { "Address": "http://integrations-api:8080/" } }
      }
    }
  },
  "Authentication": {
    "Issuer": "AiControlCenter.Identity",
    "Audience": "aicontrolcenter-api",
    "PublicKeyPath": "/run/aicontrolcenter-keys/identity-public.pem",
    "KeyId": "identity-dev-2026-01",
    "ClockSkewSeconds": 30
  },
  "ForwardedHeaders": {
    "KnownProxies": ["172.31.0.10"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*"
}
