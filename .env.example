POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=replace-with-local-superuser-password
POSTGRES_DATABASE=aicontrolcenter

IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=replace-with-local-identity-password
CONTROLPLANE_DB_USER=controlplane_user
CONTROLPLANE_DB_PASSWORD=replace-with-local-controlplane-password
ORCHESTRATOR_DB_USER=orchestrator_user
ORCHESTRATOR_DB_PASSWORD=replace-with-local-orchestrator-password
INTEGRATIONS_DB_USER=integrations_user
INTEGRATIONS_DB_PASSWORD=replace-with-local-integrations-password

RABBITMQ_USER=aicontrolcenter
RABBITMQ_PASSWORD=replace-with-local-rabbitmq-password

# Shared only by Worker and internal Orchestrator/Integrations gRPC listeners; use 32+ random characters.
WORKER_GRPC_API_KEY=replace-with-a-random-worker-grpc-key-at-least-32-characters

# GitHub OAuth App: https://github.com/settings/developers
# Homepage URL: http://localhost:8080/
# Authorization callback URL (must match exactly):
# http://localhost:8080/api/integrations/v1/provider-connections/github/oauth/callback
# Store real Client ID and Client Secret only in the ignored .env file.
GITHUB_COPILOT_OAUTH_ENABLED=false
GITHUB_COPILOT_PAT_ENABLED=false
GITHUB_COPILOT_CLIENT_ID=
GITHUB_COPILOT_CLIENT_SECRET=
GITHUB_COPILOT_CALLBACK_URL=http://localhost:8080/api/integrations/v1/provider-connections/github/oauth/callback

# Server-side provider capabilities. Current Development policy keeps OAuth/PAT disabled and Local CLI owner-scoped.
# Development-only Local Copilot CLI sidecar. Keep disabled on shared/production deployments.
# Generate LOCAL_COPILOT_CLI_CONNECTION_TOKEN as a 48-byte Base64URL secret in the ignored .env.
# LOCAL_COPILOT_CLI_OWNER_USER_ID is the Identity user allowed to use the local subscription.
# Bundled CLI 1.0.103 has no verified logout/force-login command; reauthentication and logout
# remain server-disabled capabilities and have no environment override.
LOCAL_COPILOT_CLI_ENABLED=false
LOCAL_COPILOT_CLI_CONNECTION_TOKEN=
LOCAL_COPILOT_CLI_OWNER_USER_ID=
LOCAL_COPILOT_CLI_REQUEST_TIMEOUT_SECONDS=120

# Generate these ignored files with scripts/security/New-IdentityDevelopmentKeys.ps1.
IDENTITY_JWT_PRIVATE_KEY_PATH=./secrets/identity/identity-private.pem
IDENTITY_JWT_PUBLIC_KEY_PATH=./secrets/identity/identity-public.pem

# Set real Development values only in the ignored .env file. Never commit them.
IDENTITY_BOOTSTRAP_EMAIL=
IDENTITY_BOOTSTRAP_TEMPORARY_PASSWORD=
IDENTITY_BOOTSTRAP_DISPLAY_NAME=Platform Administrator
